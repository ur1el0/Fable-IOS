# Runtime configuration
FABLE_ENV=production
FABLE_BIND_ADDRESS=127.0.0.1
FABLE_PORT=8000
FABLE_DB_PATH=fable.sqlite3
CORS_ORIGINS=[]
FABLE_MAX_REQUEST_BODY_BYTES=262144
FABLE_AUTH_RATE_WINDOW_SECONDS=900
FABLE_AUTH_REGISTER_LIMIT_PER_IP=5
FABLE_AUTH_LOGIN_LIMIT_PER_IP=60
FABLE_AUTH_LOGIN_LIMIT_PER_ACCOUNT_IP=10

# iOS Xcode Release build setting; replace with the deployed HTTPS API root.
FABLE_API_BASE_URL=

# Docker bind-mount ownership; use the host user's IDs when they differ from 1000.
FABLE_UID=1000
FABLE_GID=1000

# Optional Figma API configuration
FIGMA_PERSONAL_ACCESS_TOKEN=optional_figma_token
FIGMA_FILE_KEY=k90h1If7gNsEl56fQ1HxPq
