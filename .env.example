# Runtime configuration
FABLE_ENV=production
FABLE_BIND_ADDRESS=127.0.0.1
FABLE_PORT=8000
FABLE_DB_PATH=fable.sqlite3
FABLE_CORS_ORIGINS=[]
FABLE_MAX_REQUEST_BODY_BYTES=262144
FABLE_INGESTION_API_KEY=
FORWARDED_ALLOW_IPS=127.0.0.1
FABLE_AUTH_RATE_WINDOW_SECONDS=900
FABLE_AUTH_REGISTER_LIMIT_PER_IP=5
FABLE_AUTH_LOGIN_LIMIT_PER_IP=60
FABLE_AUTH_LOGIN_LIMIT_PER_ACCOUNT_IP=10

# iOS Xcode Release build setting; replace with the deployed HTTPS API root.
FABLE_API_BASE_URL=

# Rate limiting configuration (sliding window per-IP)
FABLE_RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_GENERAL_LIMIT=60
RATE_LIMIT_GENERAL_WINDOW=60
FABLE_RATE_LIMIT_MAX_CLIENT_BUCKETS=10000

# Docker bind-mount ownership; use the host user's IDs when they differ from 1000.
FABLE_UID=1000
FABLE_GID=1000

# Optional scheduled backup service: set FABLE_BACKUP_HOST_DIR to a mounted durable/off-host location.
FABLE_BACKUP_HOST_DIR=./backups
FABLE_BACKUP_INTERVAL_SECONDS=86400
FABLE_BACKUP_RETENTION_DAYS=30

# Local development uses the build image; production should set a release tag or GHCR digest.
FABLE_BACKEND_IMAGE=fable-backend:local

# Optional Figma API configuration
FIGMA_PERSONAL_ACCESS_TOKEN=optional_figma_token
FIGMA_FILE_KEY=k90h1If7gNsEl56fQ1HxPq
