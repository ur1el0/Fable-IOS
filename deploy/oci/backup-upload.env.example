# Copy to /etc/fable/backup-upload.env and replace the identifiers below.
# The bucket must be private. These values are identifiers, not credentials.
FABLE_BACKUP_HOST_DIR=/srv/fable/backups
FABLE_BACKUP_HEALTH_MAX_AGE_SECONDS=93600
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET=fable-backups
FABLE_BACKUP_OBJECT_PREFIX=fable

# Optional: OCI Notifications topic for backup freshness and upload failures.
# Leave blank to log failures to the systemd journal without sending alerts.
OCI_BACKUP_ALERT_TOPIC_OCID=
