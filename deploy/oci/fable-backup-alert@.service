[Unit]
Description=Send an OCI notification for failed Fable backup unit %i

[Service]
Type=oneshot
User=1000
Group=1000
WorkingDirectory=/opt/fable
Environment=HOME=/tmp
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/fable/backup-upload.env
ExecStart=/opt/fable/scripts/notify_backup_failure_to_oci.sh %i
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
